// 预约模块 — 分时配额、预约单
// 表名前缀 booking_ 做模块隔离;边界由 eslint-plugin-boundaries 在应用层保护

model BookingSlot {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(80)
  date        DateTime          @db.Date
  startTime   String            @map("start_time") @db.VarChar(5)
  endTime     String            @map("end_time") @db.VarChar(5)
  capacity    Int

  // 渠道配额(B1 方案α:各渠道独立,固定渠道不需独立表)
  miniProgramQuota Int @default(0) @map("mini_program_quota")
  onsiteQuota      Int @default(0) @map("onsite_quota")
  otaQuota         Int @default(0) @map("ota_quota")
  adminQuota       Int @default(0) @map("admin_quota")

  // 渠道已用量(乐观锁原子更新,CHECK 约束在手写 migration 中)
  miniProgramBooked Int @default(0) @map("mini_program_booked")
  onsiteBooked      Int @default(0) @map("onsite_booked")
  otaBooked         Int @default(0) @map("ota_booked")
  adminBooked       Int @default(0) @map("admin_booked")
  bookedCount       Int @default(0) @map("booked_count")

  // 在园计数(A4:90% 熔断代理指标,随核销原子+1)
  checkedInCount Int @default(0) @map("checked_in_count")

  status    BookingSlotStatus @default(ACTIVE)
  remark    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings  Booking[]

  // 同日同开始时间唯一:杜绝并发/双提交重复建时段(C4 TOCTOU 兜底);唯一索引同时充当原 (date,start_time) 索引
  @@unique([date, startTime])
  @@map("booking_slot")
}

enum BookingSlotStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Booking {
  id               String          @id @default(uuid()) @db.Uuid
  slotId           String          @map("slot_id") @db.Uuid
  // E4: 反范式所属时段日期,由 DB 触发器从 booking_slot 同步;支撑"同证同日"部分唯一索引
  slotDate         DateTime?       @map("slot_date") @db.Date
  visitorName      String          @map("visitor_name") @db.VarChar(40)
  idCard           String          @map("id_card") @db.VarChar(32)
  phone            String          @db.VarChar(20)
  plate            String?         @db.VarChar(16)
  noVehicleDeclared Boolean        @default(false) @map("no_vehicle_declared")
  channel          BookingChannel  @default(MINI_PROGRAM)
  status           BookingStatus   @default(CONFIRMED)
  qrCode           String          @unique @map("qr_code") @db.VarChar(64)
  // 动态核销码派生密钥(建单生成,永不下发);展示码为其 30s 滚动 TOTP,qrCode 退居稳定核销主键
  qrSecret         String          @map("qr_secret") @db.VarChar(64)
  checkedInAt      DateTime?       @map("checked_in_at") @db.Timestamptz(3)
  cancelledAt      DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  noShowAt         DateTime?       @map("no_show_at") @db.Timestamptz(3)
  metadata         Json?           @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  slot             BookingSlot     @relation(fields: [slotId], references: [id])

  @@index([phone])
  @@index([idCard])
  @@index([idCard, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("booking")
}

enum BookingChannel {
  MINI_PROGRAM
  ONSITE_MAKEUP
  OTA
  ADMIN_MANUAL
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
  EXPIRED
}

// BE-A2 配额规则:按「日期类型」定义的时段模板(定义端)。
// B23 每日滚动 cron 按 dayType 选模板展开成 booking_slot;各渠道配额随模板带出,capacity = 四渠道之和。
model SysSlotTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  dayType          DayType  @map("day_type")
  name             String   @db.VarChar(80)
  startTime        String   @map("start_time") @db.VarChar(5)
  endTime          String   @map("end_time") @db.VarChar(5)
  miniProgramQuota Int      @default(0) @map("mini_program_quota")
  onsiteQuota      Int      @default(0) @map("onsite_quota")
  otaQuota         Int      @default(0) @map("ota_quota")
  adminQuota       Int      @default(0) @map("admin_quota")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([dayType, startTime])
  @@map("booking_slot_template")
}

// B31 每日总库存计数(防黄牛红线 PRD1.2)。主键即日期,惰性建行;下单原子 +1 守 < 总库存,
// 取消/爽约回退 GREATEST(0, -1)。始终计数(反映当日确认数),仅当 SysConfig 总库存>0 时才作闸拦截。
model BookingDailyCounter {
  date        DateTime @id @db.Date
  totalBooked Int      @default(0) @map("total_booked")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("booking_daily_counter")
}

// BE-A2 节假日/调休/闭园覆盖。中国调休不可纯星期推算 → 运营手录,覆盖 inferDayType 的星期推断。
model SysHolidayCalendar {
  date      DateTime @id @db.Date
  dayType   DayType  @map("day_type")
  closed    Boolean  @default(false)   // 闭园日:cron 跳过不生成
  note      String?  @db.VarChar(80)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("booking_holiday_calendar")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}
