// 核销模块 — 入园核销日志
// N8: bookingId UNIQUE 作幂等键,防重复核销

model CheckinLog {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  slotId      String   @map("slot_id") @db.Uuid
  checkedInAt DateTime @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy String?  @map("checked_in_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([slotId, checkedInAt])
  @@map("checkin_log")
}
