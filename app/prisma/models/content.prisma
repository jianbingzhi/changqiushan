// content 模块 — 景区介绍、活动、知识库、资讯
// 表名前缀 content_
// R1: B 端不触发支付——content_activity_signup 仅存储/展示 C 端同步的支付状态

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model ContentIntro {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(80)
  body        String        @db.Text
  coverImage  String?       @map("cover_image") @db.VarChar(255)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sortOrder])
  @@map("content_intro")
}

model ContentActivity {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @db.VarChar(80)
  description       String?       @db.Text
  coverImage        String?       @map("cover_image") @db.VarChar(255)
  startDate         DateTime      @map("start_date") @db.Timestamptz(3)
  endDate           DateTime      @map("end_date") @db.Timestamptz(3)
  maxParticipants   Int?          @map("max_participants")
  registrationFee   Decimal       @default(0) @map("registration_fee") @db.Decimal(10, 2)
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  createdBy         String?       @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  signups           ContentActivitySignup[]
  awards            ContentAward[]

  @@index([status, startDate])
  @@map("content_activity")
}

// B24 获奖公示 — 活动获奖名单(只读公示)
model ContentAward {
  id          String          @id @default(uuid()) @db.Uuid
  activityId  String          @map("activity_id") @db.Uuid
  winnerName  String          @map("winner_name") @db.VarChar(40)
  phone       String          @db.VarChar(20)
  awardTitle  String          @map("award_title") @db.VarChar(80)
  announcedAt DateTime        @map("announced_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  activity    ContentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, announcedAt(sort: Desc)])
  @@map("content_award")
}

// R1: B 端不调起支付 — paymentStatus 由 C 端同步，B 端只读/展示
model ContentActivitySignup {
  id            String        @id @default(uuid()) @db.Uuid
  activityId    String        @map("activity_id") @db.Uuid
  userId        String        @map("user_id") @db.VarChar(32)
  userName      String        @map("user_name") @db.VarChar(40)
  phone         String        @db.VarChar(20)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  // 微信支付(活动报名费,隔离):订单号/交易号;wxTransactionId 唯一保证回调幂等
  wxOrderId       String?     @map("wx_order_id") @db.VarChar(64)
  wxTransactionId String?     @unique @map("wx_transaction_id") @db.VarChar(64)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity      ContentActivity @relation(fields: [activityId], references: [id])

  @@index([activityId, paymentStatus])
  @@map("content_activity_signup")
}

model ContentKnowledge {
  id        String        @id @default(uuid()) @db.Uuid
  title     String        @db.VarChar(80)
  content   String        @db.Text
  category  String?       @db.VarChar(40)
  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, sortOrder])
  @@map("content_knowledge")
}

// 导览 POI(景点/餐饮/卫生间/观景台等);经纬度供小程序地图标注
// ⚠️ 坐标系铁律:latitude/longitude 全库统一 GCJ-02(高德原生,经拾取器取点),
// 严禁混入 WGS-84(GPS 原始值,川西偏差 300–500m)——上图/导航全链路按 GCJ-02 消费。
model ContentPoi {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(80)
  category    String        @db.VarChar(40)
  latitude    Decimal       @db.Decimal(10, 7)
  longitude   Decimal       @db.Decimal(10, 7)
  description String?       @db.Text
  coverImage  String?       @map("cover_image") @db.VarChar(255)
  sortOrder   Int           @default(0) @map("sort_order")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, category])
  @@map("content_poi")
}

model ContentNews {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(80)
  summary     String?       @db.Text
  body        String        @db.Text
  coverImage  String?       @map("cover_image") @db.VarChar(255)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, publishedAt(sort: Desc)])
  @@map("content_news")
}

// R-素材 媒体素材库 — 上传后归档,活动/资讯封面可引用。activityId 可空 → 通用素材库。
model ContentAsset {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String?  @map("activity_id") @db.Uuid
  name       String   @db.VarChar(120)
  key        String   @unique @db.VarChar(255)  // 对象存储 key(public/assets/<uuid>.<ext>)
  url        String   @db.VarChar(512)           // 公网读 URL
  type       String   @db.VarChar(40)            // contentType
  size       Int                                 // 字节
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([activityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("content_asset")
}
