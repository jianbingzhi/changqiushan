DATABASE_URL="postgresql://changqiushan:changqiushan_dev@localhost:5433/changqiushan?schema=public"

# LOG_LEVEL=debug

# === Vercel + Supabase 临时部署(见 .claude/plan/b-deploy-vercel-supabase.md) ===
# 本地 docker 全部留空即可,以下仅 Vercel 环境设。一套代码两套部署。
# 运行时 DATABASE_URL 换成 Supabase 连接池(Transaction 模式,端口 6543):
#   DATABASE_URL="postgresql://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 迁移/seed 用直连(端口 5432);本地不设则回退 DATABASE_URL:
#   DIRECT_URL="postgresql://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:5432/postgres"
# DB_POOL_MAX=1                       # serverless 每实例池上限(Vercel 自动按 VERCEL 取 1)
# SUPABASE_ANON_KEY="<anon-key>"      # Supabase 云 Auth 网关要求登录 fetch 带 apikey 头
# GOTRUE_URL / GOTRUE_JWT_ISSUER = https://<ref>.supabase.co/auth/v1
# GOTRUE_JWKS_URL —— Supabase 用户 token 用 ES256 非对称签发,须用 JWKS 公钥验签:
#   https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#   设了就走 JWKS;本地/自托管 GoTrue(HS256)不设,继续用 GOTRUE_JWT_SECRET。
# GOTRUE_JWKS_URL="https://<ref>.supabase.co/auth/v1/.well-known/jwks.json"
# 注:Supabase 默认关手机号登录 → 用 PAT/Dashboard 开 external_phone_enabled;管理员需 app_metadata.role。
# NEXT_PUBLIC_REALTIME_ENABLED=false  # Vercel 关实时(SSE);本地不设=保持实时
CRON_SECRET="<openssl rand -hex 32>"  # 【必填】cron 路由(refresh-mv)鉴权;未配置则路由 fail-closed 返回 500

# === 数字大屏软门(无登录大屏的应用层兜底)===
# 大屏 /screen/* 与 /api/screen/* 无须登录。生产以 Nginx IP 白名单为主;此 token 为应用层辅助。
# 留空 / 不设 = 完全开放(本地/演示零摩擦);配置后须带 ?k=<token> 首次进入(自动写 cookie)。
# 生成: openssl rand -hex 32
# SCREEN_TOKEN=""

# === 媒体存储:S3 兼容(本地 MinIO / Vercel Supabase Storage / 生产阿里云 OSS 同代码切端点) ===
# S3_ENDPOINT="https://<ref>.supabase.co/storage/v1/s3"   # 服务端自用;docker 内网 MinIO=http://minio:9000
# S3_PUBLIC_ENDPOINT="http://localhost:9000"              # 浏览器直传/预签名用(主机可达);缺省回退 S3_ENDPOINT
# S3_REGION="ap-southeast-1"
# S3_ACCESS_KEY="<access-key>"
# S3_SECRET_KEY="<secret-key>"
# S3_BUCKET="changqiushan-media"
# S3_FORCE_PATH_STYLE="true"                               # MinIO/Supabase=true;OSS 视设定。缺省 true
# S3_PUBLIC_BASE_URL=""                                    # 公网读基址(CDN/桶域名);留空则由 S3_PUBLIC_ENDPOINT+bucket 拼

# === 红线 4 瞬时承载量(D1 占位)===
# 在园人数/承载量达 90% 时大屏与仪表盘闪红 + 自动停当日预约。
# ⚠️ 占位单值,待 PRD 给定正式瞬时承载量后替换。
# PARK_INSTANT_CAPACITY=5000

# === 登录 cookie(B21/B16)===
# 内网 http(VPN)QA 置 false,否则浏览器不回传 secure cookie 导致"点登录没反应";生产 https 置 true。
# COOKIE_SECURE=false
# cookie 寿命与 GoTrue JWT 寿命对齐(秒);⚠️ 生产推荐 3600(1h)+ 已落地的 middleware 滑动续期,勿照抄演示的 604800(7天)。
# GOTRUE_JWT_EXP=3600   # 演示态曾用 604800(7天);生产改 1h,靠 refresh 续期

# === GoTrue 认证(D3) ===
GOTRUE_DB_PASSWORD="auth_dev_pwd"
# 生成: openssl rand -hex 32 (compose 与应用必须一致)
GOTRUE_JWT_SECRET="<openssl rand -hex 32>"
GOTRUE_URL="http://localhost:9999"

# === C 端游客鉴权(微信小程序) ===
# 自签游客 JWT 密钥,与 GOTRUE_JWT_SECRET 必须不同(游客/管理员体系隔离)
# 生成: openssl rand -hex 32
VISITOR_JWT_SECRET="<openssl rand -hex 32>"
# 微信小程序凭据 — 仅服务端读取,绝不下发前端(上线走集成配置中心)
WECHAT_APPID="<wx-appid>"
WECHAT_SECRET="<wx-app-secret>"

# === AI 问答(直连大模型,OpenAI 兼容;不做 RAG) ===
# key 仅服务端读取,绝不下发前端
AI_BASE_URL="https://api.example.com/v1"
AI_MODEL="<model-name>"
AI_API_KEY="<llm-api-key>"

# === 微信支付 APIv3(仅活动报名费二消,隔离;入园主流程零支付) ===
# 商户私钥/APIv3密钥/平台证书仅服务端持有,绝不下发
WXPAY_MCH_ID="<mch-id>"
WXPAY_SERIAL_NO="<cert-serial-no>"
WXPAY_PRIVATE_KEY="<merchant-private-key-PEM, \n 转义>"
WXPAY_API_V3_KEY="<apiv3-key-32bytes>"
WXPAY_PLATFORM_PUBLIC_KEY="<wxpay-platform-public-key-PEM, \n 转义>"
WXPAY_NOTIFY_URL="https://<已备案域名>/api/c/payment/wechat/callback"
# 可选:回调来源 IP 白名单(逗号分隔),留空则不校验
WXPAY_CALLBACK_IPS=""

# === 高德地图(traffic 路况 REST + 浏览器地图组件) ===
# AMAP_KEY:Web 服务 key(服务端 REST 路况/静态图)——仅服务端读取,严禁加 NEXT_PUBLIC 前缀
# AMAP_KEY="<amap-web-service-key>"
# NEXT_PUBLIC_AMAP_KEY:Web 端 JS API key(浏览器地图组件加载,需控制台配域名白名单)
# NEXT_PUBLIC_AMAP_KEY="<amap-jsapi-key>"
# NEXT_PUBLIC_AMAP_SECURITY:JS API 安全密钥(securityJsCode)。
# ⚠️ 会打进前端 bundle,属演示级用法;生产应改 serviceHost(Nginx 代理 _AMapService)方案,不下发密钥。
# NEXT_PUBLIC_AMAP_SECURITY="<amap-jsapi-security-code>"
# AMAP_WEATHER_CITY:大屏实时天气查询的城市 adcode,与 AMAP_KEY 共用同一个 Web 服务 key。
# 缺省蒲江县 510131(长秋山所在地);想按成都市口径展示改 510100。
# ⚠️ 高德 weatherInfo 接口不返回空气质量,AQI 需另接环境监测源。
# AMAP_WEATHER_CITY="510131"

# 视频上传单文件上限(字节)。缺省 100MB;Supabase 免费档单文件 50MB,Vercel 环境应设 52428800。
# MAX_VIDEO_UPLOAD_BYTES="104857600"
