DATABASE_URL="postgresql://changqiushan:changqiushan_dev@localhost:5433/changqiushan?schema=public"

# LOG_LEVEL=debug

# === GoTrue 认证(D3) ===
GOTRUE_DB_PASSWORD="auth_dev_pwd"
# 生成: openssl rand -hex 32 (compose 与应用必须一致)
GOTRUE_JWT_SECRET="<openssl rand -hex 32>"
GOTRUE_URL="http://localhost:9999"

# === C 端游客鉴权(微信小程序) ===
# 自签游客 JWT 密钥,与 GOTRUE_JWT_SECRET 必须不同(游客/管理员体系隔离)
# 生成: openssl rand -hex 32
VISITOR_JWT_SECRET="<openssl rand -hex 32>"
# 微信小程序凭据 — 仅服务端读取,绝不下发前端(上线走集成配置中心)
WECHAT_APPID="<wx-appid>"
WECHAT_SECRET="<wx-app-secret>"
