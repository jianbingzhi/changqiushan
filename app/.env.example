DATABASE_URL="postgresql://changqiushan:changqiushan_dev@localhost:5433/changqiushan?schema=public"

# LOG_LEVEL=debug

# === Vercel + Supabase 临时部署(见 .claude/plan/b-deploy-vercel-supabase.md) ===
# 本地 docker 全部留空即可,以下仅 Vercel 环境设。一套代码两套部署。
# 运行时 DATABASE_URL 换成 Supabase 连接池(Transaction 模式,端口 6543):
#   DATABASE_URL="postgresql://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 迁移/seed 用直连(端口 5432);本地不设则回退 DATABASE_URL:
#   DIRECT_URL="postgresql://postgres.<ref>:<pwd>@<region>.pooler.supabase.com:5432/postgres"
# DB_POOL_MAX=1                       # serverless 每实例池上限(Vercel 自动按 VERCEL 取 1)
# SUPABASE_ANON_KEY="<anon-key>"      # Supabase 云 Auth 网关要求登录 fetch 带 apikey 头
# NEXT_PUBLIC_REALTIME_ENABLED=false  # Vercel 关实时(SSE);本地不设=保持实时
# CRON_SECRET="<openssl rand -hex 32>"  # Vercel Cron 刷新物化视图的鉴权

# === 媒体存储:S3 兼容(本地 MinIO / Vercel Supabase Storage / 生产阿里云 OSS 同代码切端点) ===
# S3_ENDPOINT="https://<ref>.supabase.co/storage/v1/s3"   # 本地 MinIO=http://localhost:9000
# S3_REGION="ap-southeast-1"
# S3_ACCESS_KEY="<access-key>"
# S3_SECRET_KEY="<secret-key>"
# S3_BUCKET="changqiushan-media"

# === 红线 4 瞬时承载量(D1 占位)===
# 在园人数/承载量达 90% 时大屏与仪表盘闪红 + 自动停当日预约。
# ⚠️ 占位单值,待 PRD 给定正式瞬时承载量后替换。
# PARK_INSTANT_CAPACITY=5000

# === 登录 cookie(B21/B16)===
# 内网 http(VPN)QA 置 false,否则浏览器不回传 secure cookie 导致"点登录没反应";生产 https 置 true。
# COOKIE_SECURE=false
# cookie 寿命与 GoTrue JWT 寿命对齐(秒);⚠️ 生产应调短 + 落地滑动续期,勿无续期长期留 7 天。
# GOTRUE_JWT_EXP=604800

# === GoTrue 认证(D3) ===
GOTRUE_DB_PASSWORD="auth_dev_pwd"
# 生成: openssl rand -hex 32 (compose 与应用必须一致)
GOTRUE_JWT_SECRET="<openssl rand -hex 32>"
GOTRUE_URL="http://localhost:9999"

# === C 端游客鉴权(微信小程序) ===
# 自签游客 JWT 密钥,与 GOTRUE_JWT_SECRET 必须不同(游客/管理员体系隔离)
# 生成: openssl rand -hex 32
VISITOR_JWT_SECRET="<openssl rand -hex 32>"
# 微信小程序凭据 — 仅服务端读取,绝不下发前端(上线走集成配置中心)
WECHAT_APPID="<wx-appid>"
WECHAT_SECRET="<wx-app-secret>"

# === AI 问答(直连大模型,OpenAI 兼容;不做 RAG) ===
# key 仅服务端读取,绝不下发前端
AI_BASE_URL="https://api.example.com/v1"
AI_MODEL="<model-name>"
AI_API_KEY="<llm-api-key>"

# === 微信支付 APIv3(仅活动报名费二消,隔离;入园主流程零支付) ===
# 商户私钥/APIv3密钥/平台证书仅服务端持有,绝不下发
WXPAY_MCH_ID="<mch-id>"
WXPAY_SERIAL_NO="<cert-serial-no>"
WXPAY_PRIVATE_KEY="<merchant-private-key-PEM, \n 转义>"
WXPAY_API_V3_KEY="<apiv3-key-32bytes>"
WXPAY_PLATFORM_PUBLIC_KEY="<wxpay-platform-public-key-PEM, \n 转义>"
WXPAY_NOTIFY_URL="https://<已备案域名>/api/c/payment/wechat/callback"
# 可选:回调来源 IP 白名单(逗号分隔),留空则不校验
WXPAY_CALLBACK_IPS=""
